        </mxCell>
        <mxCell id="8LjoA9YiSq1YRo73to7H-12" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=0;labelBackgroundColor=none;" value="&lt;span style=&quot;background-color: light-dark(rgb(23, 28, 36), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Based on&amp;nbsp;&lt;br&gt;&lt;span style=&quot;font-family: Inter, &amp;quot;Segoe UI&amp;quot;, system-ui, sans-serif; text-align: start;&quot;&gt;Mohammadnazar et al. (2021), temporal driving volatility.&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="195" x="60" y="760" as="geometry" />
        </mxCell>
        <mxCell id="N-b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Windows and volatility features&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Acceleration = Δspeed ÷ (3.6 × Δt), windows of 10–30 s&lt;br&gt;Speed-Cv, Speed-Dmean, Speed-Qcv, Speed-Vf, Accel-Dmean&lt;br&gt;&lt;i&gt;Study: Mohammadnazar et al. (2021)&lt;br&gt;Own: longer window, no lateral measure&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="336" x="262" y="760" as="geometry" />
        </mxCell>
        <mxCell id="N-b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Classification&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Standardize, then K-means with 3 clusters.&lt;br&gt;Silhouette check for k = 2 to 5, &lt;br&gt;centers frozen for new windows&lt;br&gt;&lt;i&gt;Study: Mohammadnazar et al. (2021); &lt;br&gt;Kostopoulos et al. (2024)&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="336" x="262" y="915" as="geometry" />
        </mxCell>
        <mxCell id="N-b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Driving score&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Mean of window labels, then (s − 1) × 50 = score 0 to 100&lt;br&gt;Five bands, Very Poor to Excellent&lt;br&gt;&lt;i&gt;Study: Mohammadnazar et al. (2021), Fig. 2-9&lt;br&gt;Own: 0 to 100 rescale, three driver classes&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="336" x="262" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="N-val" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;dashed=1;dashPattern=8 8;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Validation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(side check)&lt;br&gt;Harsh-event cross-check, labeled OBD trips: confusion matrix, F1&lt;br&gt;&lt;i&gt;Study: Ameen et al. (2021); Sağbaş (2026)&lt;br&gt;Dataset details not yet verified&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="160" x="60" y="950" as="geometry" />
        </mxCell>
        <mxCell id="N-e-steward-b5" edge="1" parent="1" source="N-steward" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=default;" target="N-b5" value="clean 1 Hz speed series per car">
          <mxGeometry relative="1" x="-0.2308" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="N-e-b5-b6" edge="1" parent="1" source="N-b5" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;" target="N-b6" value="5 numbers per window">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-e-b6-b7" edge="1" parent="1" source="N-b6" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;" target="N-b7" value="Label per window: Calm 3, Normal 2, Aggressive 1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-e-b6-val" edge="1" parent="1" source="N-b6" style="endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.105;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-val" value="checks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-e-b7-val" edge="1" parent="1" source="N-b7" style="endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.895;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-val" value="checks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8LjoA9YiSq1YRo73to7H-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;Layer 3: Dashboard &amp;amp; Feedback&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="300" x="60" y="1225" as="geometry" />
        </mxCell>
        <mxCell id="8LjoA9YiSq1YRo73to7H-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="575" width="760" x="40" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="N-b9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Coach agent and gamification&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Each message targets one TPB factor:&lt;br&gt;Attitude: consequences of own driving (sent first)&lt;br&gt;Subjective norm: peer comparison, leaderboard&lt;br&gt;Perceived control: achievable challenges, streaks, tips&lt;br&gt;Every message is stored with its factor tag&lt;br&gt;&lt;i&gt;Study: Ajzen (1991), factors as &quot;points of attack&quot; (p. 206); Somoray et al. (2024), attitude strongest; Kontaxi (2025), scorecards and challenges worked best, gains faded after feedback stopped&lt;br&gt;Own: message rules and templates&lt;/i&gt;" vertex="1">
          <mxGeometry height="185" width="336" x="262" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="N-b10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Dashboard (Grafana)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Score trend, band, braking and acceleration sub-scores, leaderboard&lt;br&gt;&lt;i&gt;Own design, shows the score as Kontaxi's scorecard feature&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="336" x="262" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="N-mon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;dashed=1;dashPattern=8 8;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Model Monitor agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(extension)&lt;br&gt;Watches the mix of Calm, Normal and Aggressive windows for drift&lt;br&gt;&lt;i&gt;Own design&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="150" x="636" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="N-e-b7-b9" edge="1" parent="1" source="N-b7" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=default;" target="N-metrics" value="Score, band and class per driver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-e-b9-b10" edge="1" parent="1" source="N-b9" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;" target="N-b10" value="Alerts, badges, leaderboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-e-mon-b6" edge="1" parent="1" source="N-mon" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-b6" value="re-training trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-legend" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;Legend:&lt;/b&gt; solid box = block in the main flow; dashed box = side check or extension. &quot;Study&quot; = published source the block follows. &quot;Own&quot; = engineering choice made for this project.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sources:&lt;/b&gt; Ajzen (1991), Organizational Behavior and Human Decision Processes, 50, 179-211. Somoray, White, Watson and Lewis (2024), Accident Analysis and Prevention, 208, 107797. Mohammadnazar, Arvin and Khattak (2021), Transportation Research Part C, 122, 102917. Kostopoulos et al. (2024), Sustainability, 16(14), 6151. Kontaxi (2025), PhD thesis, NTUA (English summary). Ameen et al. (2021) and Sağbaş (2026): cited from earlier research, not re-read." vertex="1">
          <mxGeometry height="110" width="760" x="40" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="l5i20zJQrCjp0tuegTyK-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div dir=&quot;ltr&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot;&gt;Measure&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;Equation&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;What it reflects&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Cv&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Cv = (standard deviation ÷ |x̄|) × 100&lt;/td&gt;&lt;td&gt;How much speed varies &lt;strong&gt;compared with the driver’s usual speed&lt;/strong&gt;. 10 km/h of variation matters more at 30 km/h than at 120 km/h.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Dmean&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Dmean = (1/n) × Σ |xᵢ − x̄|&lt;/td&gt;&lt;td&gt;The &lt;strong&gt;typical distance from the average speed&lt;/strong&gt;, in km/h.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Qcv&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Qcv = ((Q3 − Q1) ÷ (Q3 + Q1)) × 100&lt;/td&gt;&lt;td&gt;The spread of the &lt;strong&gt;middle half&lt;/strong&gt; of the readings. Rare spikes are ignored, so it shows the regular variability.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Vf&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;rᵢ = ln(xᵢ ÷ xᵢ₋₁) × 100, then Vf = standard deviation of the rᵢ&lt;/td&gt;&lt;td&gt;How large and how &lt;strong&gt;sudden the second-to-second changes&lt;/strong&gt; are. Frequent sharp speeding up and slowing down gives a high value. It works only for speed.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Accel-Dmean&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;The same Dmean equation, applied to &lt;strong&gt;acceleration&lt;/strong&gt; (m/s²)&lt;/td&gt;&lt;td&gt;How &lt;strong&gt;hard&lt;/strong&gt; the driver accelerates and brakes compared with their own average.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;In all five, a &lt;strong&gt;higher value means less stable driving&lt;/strong&gt;.&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="510" width="2050" x="980" y="185" as="geometry" />
        </mxCell>
        <mxCell id="N-metrics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Behaviour metrics&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Per trip and driver: % of Aggressive windows, the same per road type, 4-week trend&lt;br&gt;&lt;i&gt;Study: Ajzen (1991), the TPB &quot;behaviour&quot; node, defined precisely (compatibility principle, p. 185)&lt;br&gt;Own: the metric definitions&lt;/i&gt;" vertex="1">
          <mxGeometry x="262" y="1300" width="336" height="110" as="geometry" />
        </mxCell>
        <mxCell id="N-e-metrics-b9" edge="1" parent="1" source="N-metrics" target="N-b9" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=default;" value="Behaviour per driver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N-tpb-note" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=0;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Based on&lt;br&gt;Ajzen (1991), Theory of Planned Behavior, and Somoray et al. (2024), TPB meta-analysis of risky driving.&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry x="50" y="1380" width="205" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>