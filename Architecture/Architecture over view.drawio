        <mxCell id="N-steward" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Data Quality Steward (agent)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Drops zero speeds, flags gaps and impossible jumps&lt;br&gt;&lt;i&gt;Study: Mohammadnazar et al. (2021) remove zero speeds and outliers&lt;br&gt;Own: doing it as an agent&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="336" x="262" y="545" as="geometry" />
        </mxCell>
