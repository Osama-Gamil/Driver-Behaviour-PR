            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="N-e-b5-b6" edge="1" parent="1" source="N-b5" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;" target="N-b6" value="5 numbers per window">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-b6-b7" edge="1" parent="1" source="N-b6" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;" target="N-b7" value="Label per window: Calm 3, Normal 2, Aggressive 1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-b6-val" edge="1" parent="1" source="N-b6" style="endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.105;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-val" value="checks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-b7-val" edge="1" parent="1" source="N-b7" style="endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.895;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-val" value="checks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="8LjoA9YiSq1YRo73to7H-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;Layer 3: Dashboard &amp;amp; Feedback&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="300" x="60" y="1225" as="geometry"/>
        </mxCell>
        <mxCell id="8LjoA9YiSq1YRo73to7H-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="620" width="760" x="40" y="1270" as="geometry"/>
        </mxCell>
        <mxCell id="N-b9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;verticalAlign=top;spacingTop=8;align=left;spacingLeft=12;spacingRight=380;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Coach agent and gamification (planned)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Study: Kontaxi (2025): scorecard and competitions worked best; about half of drivers slipped back within 150 trips after feedback stopped&lt;br&gt;Own: each message targets one TPB factor (Ajzen, 1991), attitude first (Somoray et al., 2024). Kontaxi does not use TPB.&lt;/i&gt;" vertex="1">
          <mxGeometry height="355" width="728" x="56" y="1410" as="geometry"/>
        </mxCell>
        <mxCell id="N-b10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Dashboard (Grafana)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Score trend, band, braking and acceleration sub-scores, leaderboard&lt;br&gt;&lt;i&gt;Own design, shows the score as Kontaxi's scorecard feature&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="336" x="262" y="1795" as="geometry"/>
        </mxCell>
        <mxCell id="N-mon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;dashed=1;dashPattern=8 8;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Model Monitor agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(extension)&lt;br&gt;Watches the mix of Calm, Normal and Aggressive windows for drift&lt;br&gt;&lt;i&gt;Own design&lt;/i&gt;" vertex="1">
          <mxGeometry height="95" width="150" x="636" y="1290" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-b7-b9" edge="1" parent="1" source="N-b7" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=default;" target="N-tripscores" value="Score, band and class per trip">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-b9-b10" edge="1" parent="1" source="N-msgs" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" target="N-b10" value="messages, challenge progress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-e-mon-b6" edge="1" parent="1" source="N-mon" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;rounded=0;dashed=1;defaultLabelBackgroundColor=page;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=default;" target="N-b6" value="re-training trigger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="N-legend" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;Legend:&lt;/b&gt; solid box = block in the main flow; dashed box = side check or extension; cylinder = stored table. &quot;Study&quot; = published source the block follows. &quot;Own&quot; = engineering choice made for this project. &quot;(planned)&quot; = designed, not coded yet.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sources:&lt;/b&gt; Mohammadnazar, Arvin and Khattak (2021), Transportation Research Part C, 122, 102917. Kostopoulos et al. (2024), Sustainability, 16(14), 6151. Kontaxi (2025), The Driver Behavior Telematics Feedback Mechanism, PhD thesis, NTUA. Ajzen (1991), Organizational Behavior and Human Decision Processes, 50(2), 179–211. Somoray et al. (2024). Simons-Morton et al. (2013), Accident Analysis and Prevention, 51. Sağbaş et al. (2026), PeerJ Computer Science, 12:e3493." vertex="1">
          <mxGeometry height="130" width="760" x="40" y="1910" as="geometry"/>
        </mxCell>
        <mxCell id="l5i20zJQrCjp0tuegTyK-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div dir=&quot;ltr&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot;&gt;Measure&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;Equation&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;What it reflects&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Cv&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Cv = (standard deviation ÷ |x̄|) × 100&lt;/td&gt;&lt;td&gt;How much speed varies &lt;strong&gt;compared with the driver’s usual speed&lt;/strong&gt;. 10 km/h of variation matters more at 30 km/h than at 120 km/h.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Dmean&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Dmean = (1/n) × Σ |xᵢ − x̄|&lt;/td&gt;&lt;td&gt;The &lt;strong&gt;typical distance from the average speed&lt;/strong&gt;, in km/h.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Qcv&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Qcv = ((Q3 − Q1) ÷ (Q3 + Q1)) × 100&lt;/td&gt;&lt;td&gt;The spread of the &lt;strong&gt;middle half&lt;/strong&gt; of the readings. Rare spikes are ignored, so it shows the regular variability.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Speed-Vf&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;rᵢ = ln(xᵢ ÷ xᵢ₋₁) × 100, then Vf = standard deviation of the rᵢ&lt;/td&gt;&lt;td&gt;How large and how &lt;strong&gt;sudden the second-to-second changes&lt;/strong&gt; are. Frequent sharp speeding up and slowing down gives a high value. It works only for speed.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Accel-Dmean&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;The same Dmean equation, applied to &lt;strong&gt;acceleration&lt;/strong&gt; (m/s²)&lt;/td&gt;&lt;td&gt;How &lt;strong&gt;hard&lt;/strong&gt; the driver accelerates and brakes compared with their own average.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;br&gt;&lt;p dir=&quot;ltr&quot;&gt;In all five, a &lt;strong&gt;higher value means less stable driving&lt;/strong&gt;.&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="510" width="2050" x="980" y="185" as="geometry"/>
        </mxCell>
      <mxCell id="N-tripscores" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;trip_scores (new table)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One row per trip: score, band, % Calm / Normal / Aggressive&lt;br&gt;&lt;i&gt;Own design&lt;/i&gt;" vertex="1"><mxGeometry height="80" width="336" x="262" y="1290" as="geometry"/></mxCell><mxCell id="N-tpb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Behaviour metrics (TPB)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;% Aggressive time per trip and driver&lt;br&gt;&lt;i&gt;Study: Ajzen (1991), the behaviour is defined exactly (compatibility principle)&lt;/i&gt;" vertex="1"><mxGeometry height="95" width="170" x="56" y="1290" as="geometry"/></mxCell><mxCell id="N-e-ts-tpb" edge="1" parent="1" source="N-tripscores" target="N-tpb" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N-rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Coach rules&lt;/font&gt;&lt;/b&gt;&lt;br&gt;After each trip: pick one feature and one TPB factor" vertex="1"><mxGeometry height="50" width="340" x="430" y="1430" as="geometry"/></mxCell><mxCell id="N-e-ts-rules" edge="1" parent="1" source="N-tripscores" target="N-rules" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;fontSize=12;fontColor=default;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.347;entryY=0;entryDx=0;entryDy=0;" value="read after each trip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N-feat-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=none;labelBackgroundColor=none;" value="" vertex="1"><mxGeometry height="95" width="704" x="68" y="1560" as="geometry"/></mxCell><mxCell id="N-f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Trip scorecard&lt;/font&gt;&lt;/b&gt;&lt;br&gt;after every trip&lt;br&gt;&lt;b&gt;TPB: attitude&lt;/b&gt;" vertex="1"><mxGeometry height="75" width="163" x="78" y="1570" as="geometry"/></mxCell><mxCell id="N-f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Weekly challenge&lt;/font&gt;&lt;/b&gt;&lt;br&gt;streaks, every Monday&lt;br&gt;&lt;b&gt;TPB: perceived control&lt;/b&gt;" vertex="1"><mxGeometry height="75" width="163" x="251" y="1570" as="geometry"/></mxCell><mxCell id="N-f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Fleet comparison&lt;/font&gt;&lt;/b&gt;&lt;br&gt;weekly summary only&lt;br&gt;&lt;b&gt;TPB: subjective norm&lt;/b&gt;" vertex="1"><mxGeometry height="75" width="163" x="424" y="1570" as="geometry"/></mxCell><mxCell id="N-f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Slip-back watch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;last 10 trips vs own good level&lt;br&gt;&lt;b&gt;TPB: attitude first&lt;/b&gt;" vertex="1"><mxGeometry height="75" width="163" x="597" y="1570" as="geometry"/></mxCell><mxCell id="N-e-rules-feat" edge="1" parent="1" source="N-rules" target="N-feat-group" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgro